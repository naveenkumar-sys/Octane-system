# ========================================================
# Octane Systems - Docker Production Environment Variables
# ========================================================

# HTTP Port exposed to users (Default: 80, can be set to 8080 or 3000 if 80 is in use)
PORT=80

# PostgreSQL Configuration
POSTGRES_DB=octane_systems
POSTGRES_USER=octane_user
POSTGRES_PASSWORD=OctaneSuperSecretPassword2026!

# Django Security & App Settings
SECRET_KEY=change-this-to-a-very-long-random-string-in-production-123456789!@#$%^
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
